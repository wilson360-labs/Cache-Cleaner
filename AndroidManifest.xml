<?xml version="1.0" encoding="utf-8"?>
<manifest
    android:compileSdkVersion="34"
    android:compileSdkVersionCodename="14"
    package="com.example.cachecleaner"
    platformBuildVersionCode="34"
    platformBuildVersionName="14"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permite que una app vea todos los paquetes que se instalaron. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Permitir que la aplicación use Shizuku. -->
    <uses-permission
        android:name="moe.shizuku.manager.permission.API_V23" />
    <application
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:label="Cache Cleaner"
        android:icon="@mipmap/ic_launcher"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:roundIcon="@mipmap/ic_launcher_round">
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:authorities="com.example.cachecleaner.shizuku" />
        <activity
            android:name="com.example.cachecleaner.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
    </application>
</manifest>